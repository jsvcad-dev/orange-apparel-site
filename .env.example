# Orange Apparel storefront — environment variables
# Add these in your host's dashboard (Vercel: Project → Settings → Environment Variables).

# Your Fourthwall storefront token (Fourthwall → Settings → For Developers → Headless). Starts with ptkn_
NEXT_PUBLIC_FW_STOREFRONT_TOKEN="ptkn_..."

# Your Fourthwall shop address, used for checkout
NEXT_PUBLIC_FW_CHECKOUT="https://orange-apparel.store"

# This site's own address, WITHOUT https:// (used for the sitemap and social share previews)
NEXT_PUBLIC_VERCEL_URL="orange-apparel.store"

# Which collection the homepage shows ("all" = every product)
NEXT_PUBLIC_FW_COLLECTION="all"

# Use Fourthwall's image resizing (recommended: avoids image-processing limits on your host)
NEXT_PUBLIC_USE_FW_IMAGE_OPTIMIZATION="true"

# Optional: lets Fourthwall tell the site instantly when you edit a product (otherwise changes show within an hour)
# FOURTHWALL_WEBHOOK_SECRET="any-long-random-string"

# Pre-launch: "true" shows the "coming soon" page on every URL instead of the shop
NEXT_PUBLIC_COMING_SOON="false"
